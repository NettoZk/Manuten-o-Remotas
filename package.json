{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "node --no-experimental-require-module -e \"require('firebase-admin/auth'); require('firebase-admin/firestore')\" && next build",
    "check:runtime": "node scripts/check-runtime.mjs",
    "verify:vercel": "node --test scripts/vercel-readiness.test.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "test:history": "node scripts/run-emulator-tests.mjs history",
    "test:emulators": "firebase emulators:exec --project demo-remotas-tests --only auth,firestore \"npm run test:integration\"",
    "emulators": "firebase emulators:start --project demo-remotas-tests --only auth,firestore",
    "dev:local": "node scripts/dev-local.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "test:e2e": "node scripts/run-emulator-tests.mjs browser",
    "test:all": "npm test && npm run test:history && npm run test:e2e && npm run typecheck && npm run lint && npm run build"
  },
