# Configuração pública do aplicativo Web do Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Exclusivas do servidor. Nunca usar NEXT_PUBLIC_ nestas credenciais.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternativa: GOOGLE_APPLICATION_CREDENTIALS aponta para um arquivo externo ao repositório.

# Somente durante a criação do primeiro administrador; remover após configurar.
FIREBASE_SETUP_TOKEN=

# Testes locais: npm run dev:local e npm run emulators configuram os emuladores.
# Não habilitar em produção.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
